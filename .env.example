# ==== App ====
APP_NAME=FreeFireTopUpBot
APP_ENV=production
APP_SECRET_KEY=change-this-to-a-long-random-string
APP_TIMEZONE=Asia/Dhaka
CURRENCY=BDT

# ==== Database ====
# postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://ff_user:ff_password@localhost:5432/ff_topup
# sync url used by alembic
DATABASE_URL_SYNC=postgresql+psycopg2://ff_user:ff_password@localhost:5432/ff_topup

# ==== Telegram Bot ====
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Your own Telegram numeric user ID(s), comma-separated. These accounts get the admin
# menu inside the bot. Find your ID by messaging @userinfobot on Telegram.
TELEGRAM_ADMIN_IDS=111111111,222222222

# ==== Render / hosting ====
# Render sets this automatically -- you normally do NOT need to set it yourself.
PORT=8000

# ==== Security ====
# 32-byte urlsafe base64 key for Fernet encryption of provider API keys.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ==== Order status polling (no webhooks) ====
ORDER_POLL_INTERVAL_SECONDS=45
